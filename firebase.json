{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "database.rules.json",
      "storage.rules",
      ".firebaserc",
      "functions/**",
      "*.docx",
      "*.pdf",
      ".git/**",
      "**/*.csv",
      "**/*.xlsx",
      "**/membres_*.json",
      "**/alle_personer*",
      "**/afvigelser*",
      "byg_membres_fra_pdf.js",
      "export_membres.js",
      "export_personer_csv.js",
      "import_manglende.js",
      "ret_esther.js",
      "lav_excel.js",
      "*.py",
      "package.json",
      ".gitignore",
      ".github/**",
      "**/node_modules/**",
      "CLAUDE.md",
      "STATUS.md",
      "README.md"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
