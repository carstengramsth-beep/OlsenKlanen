rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /fotovaeg/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.resource.size < 15 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }
    match /musik/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.resource.size < 20 * 1024 * 1024
                            && request.resource.contentType.matches('audio/.*');
      allow delete: if true;
    }
    match /musik {
      allow read: if true;
    }
    match /gamle_billeder/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /olsenpost_vedhaeftninger/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.postansvarlig == true;
    }
  }
}
